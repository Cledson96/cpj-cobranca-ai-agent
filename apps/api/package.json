{
  "name": "@cpj-cobranca/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "cross-env RUST_LOG=info PRISMA_HIDE_UPDATE_MESSAGE=1 prisma generate --no-hints",
    "prisma:migrate": "cross-env RUST_LOG=info PRISMA_HIDE_UPDATE_MESSAGE=1 prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@cpj-cobranca/shared": "0.1.0",
    "@fastify/cors": "^11.2.0",
    "@langchain/core": "^1.1.48",
    "@langchain/langgraph": "^1.3.2",
    "@prisma/client": "^6.19.3",
    "fastify": "^5.3.3",
    "fastify-plugin": "^5.1.0",
    "zod": "^3.25.28",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "cross-env": "^10.1.0",
    "dotenv": "^16.6.1",
    "prisma": "^6.19.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
